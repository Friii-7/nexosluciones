---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'NEXO · Mantenimiento Integral y Tecnológico',
	description = 'Soluciones completas de mantenimiento, tecnología y seguridad para propiedades y hogares.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/img/nexo-logo.png" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap"
			rel="stylesheet"
		/>
		<link
			rel="stylesheet"
			href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
			integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
			crossorigin="anonymous"
			referrerpolicy="no-referrer"
		/>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	*,
	*::before,
	*::after {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		font-family: 'Outfit', sans-serif;
		background:
			radial-gradient(ellipse 80% 50% at 100% -10%, rgba(245, 179, 66, 0.12), transparent 50%),
			radial-gradient(ellipse 60% 40% at 0% 20%, rgba(59, 130, 180, 0.08), transparent 45%),
			linear-gradient(180deg, #eef3fa 0%, #f4f7fc 40%, #e8eef6 100%);
		background-attachment: fixed;
		color: #1e2a3a;
		line-height: 1.5;
		min-height: 100vh;
	}

	a {
		text-decoration: none;
		color: inherit;
	}

	img,
	video {
		max-width: 100%;
		display: block;
	}

	button {
		font-family: inherit;
	}
</style>
