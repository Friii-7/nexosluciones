<script>
	const navButtons = document.querySelectorAll('#mainNav button');
	const pages = {
		inicio: document.getElementById('page-inicio'),
		servicios: document.getElementById('page-servicios'),
		transformacion: document.getElementById('page-transformacion'),
		galeria: document.getElementById('page-galeria'),
		contacto: document.getElementById('page-contacto'),
	} as const;

	const nav = document.getElementById('mainNav');
	const navToggle = document.getElementById('navToggle');

	type PageId = keyof typeof pages;

	function navigateTo(pageId: string) {
		if (!(pageId in pages)) return;

		Object.values(pages).forEach((p) => p?.classList.remove('active'));
		pages[pageId as PageId]?.classList.add('active');

		navButtons.forEach((btn) => {
			btn.classList.toggle('active', (btn as HTMLButtonElement).dataset.page === pageId);
		});

		nav?.classList.remove('open');
		navToggle?.setAttribute('aria-expanded', 'false');

		window.scrollTo({ top: 0, behavior: 'smooth' });
	}

	navButtons.forEach((btn) => {
		btn.addEventListener('click', () => {
			const page = (btn as HTMLButtonElement).dataset.page;
			if (page) navigateTo(page);
		});
	});

	document.querySelectorAll('[data-page]').forEach((el) => {
		if (el.closest('#mainNav')) return;
		el.addEventListener('click', (e) => {
			const page = (el as HTMLElement).dataset.page;
			if (!page || !(page in pages)) return;
			e.preventDefault();
			navigateTo(page);
		});
	});

	navToggle?.addEventListener('click', () => {
		const open = nav?.classList.toggle('open');
		navToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
	});

	const copyBtn = document.getElementById('copyBtn');
	copyBtn?.addEventListener('click', async () => {
		const texto = document.getElementById('resumenTexto')?.innerText ?? '';
		try {
			await navigator.clipboard.writeText(texto);
			const original = copyBtn.innerHTML;
			copyBtn.innerHTML = '<i class="fas fa-check" aria-hidden="true"></i> ¡Copiado!';
			setTimeout(() => {
				copyBtn.innerHTML = original;
			}, 2000);
		} catch {
			alert('No se pudo copiar, selecciona el texto manualmente.');
		}
	});

	const baSlider = document.getElementById('baSlider');
	const baRange = document.getElementById('baRange') as HTMLInputElement | null;
	baRange?.addEventListener('input', () => {
		baSlider?.style.setProperty('--pos', `${baRange.value}%`);
	});

	const scrollTopBtn = document.getElementById('scrollTopBtn');
	const toggleScrollTop = () => {
		scrollTopBtn?.classList.toggle('visible', window.scrollY > 280);
	};
	window.addEventListener('scroll', toggleScrollTop, { passive: true });
	toggleScrollTop();
	scrollTopBtn?.addEventListener('click', () => {
		window.scrollTo({ top: 0, behavior: 'smooth' });
	});
</script>
